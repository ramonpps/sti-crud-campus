<%= form_with(model: campi) do |form| %>
  <% if campi.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(campi.errors.count, "error") %> prohibited this campi from being saved:</h2>

      <ul>
        <% campi.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :Name, style: "display: block" %>
    <%= form.text_field :Name %>
  </div>

  <div>
    <%= form.label :Address, style: "display: block" %>
    <%= form.text_field :Address %>
  </div>

  <div>
    <%= form.label :Number, style: "display: block" %>
    <%= form.number_field :Number %>
  </div>

  <div>
    <%= form.label :Neighborhood, style: "display: block" %>
    <%= form.text_field :Neighborhood %>
  </div>

  <div>
    <%= form.label :City, style: "display: block" %>
    <%= form.text_field :City %>
  </div>

  <div>
    <%= form.label :Postal_code, style: "display: block" %>
    <%= form.text_field :Postal_code %>
  </div>

  <div>
    <%= form.label :Deactivation, style: "display: block" %>
    <%= form.date_field :Deactivation %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
