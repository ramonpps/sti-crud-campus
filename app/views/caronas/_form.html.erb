<%= form_with(model: carona, local: true) do |form| %>
  <div class="field">
    <%= form.label :nome %>
    <%= form.text_field :nome %>
  </div>

  <div class="field">
    <%= form.label :local_partida, style: "display: inline-block; width: 150px;" %>
    <div class="input-container local-input" style="display: inline-block;">
      <%= form.collection_select :local_partida, Campu.where(Desativação: nil), :Descrição, :Descrição, { include_blank: true, class: "dropdown-input" } %>
    </div>
  </div>

  <div class="field">
    <%= form.label :destino, style: "display: inline-block; width: 150px;" %>
    <div class="input-container destino-input" style="display: inline-block;">
      <%= form.collection_select :destino, Campu.where(Desativação: nil), :Descrição, :Descrição, { include_blank: true, class: "dropdown-input" } %>
    </div>
  </div>


  <div class="field">
    <%= form.label :dia %>
    <%= form.date_field :dia %>
  </div>

  <div class="field">
    <%= form.label :hora %>
    <%= form.time_field :hora %>
  </div>

  <div class="field">
    <%= form.label :quantidade_passageiros %>
    <%= form.number_field :quantidade_passageiros %>
  </div>

  <div class="field">
    <%= form.label :valor_custo %>
    <%= form.text_field :valor_custo %>
  </div>

  <div class="field">
    <%= form.label :observacao %>
    <%= form.text_area :observacao %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>





