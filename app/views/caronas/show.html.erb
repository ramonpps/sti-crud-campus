<%= stylesheet_link_tag "bootstrap.css" %>
<%= render "cabecalho" %>
<div class="container">
  <h1>Detalhes da Carona</h1>

  <p><strong>Nome:</strong>
    <% if @carona.nome.blank? %>
      Nome indisponível
    <% else %>
      <%= @carona.nome %>
    <% end %></p>

  <p><strong>Local de Partida:</strong>
    <% if @carona.local_partida.blank? %>
      Local de partida indisponível
    <% else %>
      <%= @carona.local_partida %>
    <% end %></p>

  <p><strong>Destino:</strong>
    <% if @carona.destino.blank? %>
      Destino indisponível
    <% else %>
      <%= @carona.destino %>
    <% end %></p>

  <p><strong>Dia:</strong>
    <% if @carona.dia.present? %>
      <%= @carona.dia.strftime('%d/%m/%Y') %>
    <% else %>
      Dia indisponível
    <% end %></p>
  
  <p><strong>Hora:</strong>
    <% if @carona.hora.present? %>
      <%= @carona.hora.strftime('%H:%M') %>
    <% else %>
      Hora indisponível
    <% end %></p>

  <p><strong>Quantidade de Passageiros:</strong>
    <% if @carona.quantidade_passageiros.present? %>
      <%= @carona.quantidade_passageiros %>
    <% else %>
      Quantidade indisponível
    <% end %></p>

  <p><strong>Valor Custo:</strong>
    <% if @carona.valor_custo.present? %>
      <%= number_to_currency(@carona.valor_custo) %>
    <% else %>
      Valor indisponível
    <% end %></p>

  <p><strong>Observação:</strong>
    <% if @carona.observacao.blank? %>
      Nenhuma observação disponível
    <% else %>
      <%= @carona.observacao %>
    <% end %></p>

  <h2>Paradas</h2>
  <ul>
    <% if @paradas.blank? %>
      <p>Nenhuma parada registrada.</p>
    <% else %>
      <% @paradas.each do |parada| %>
        <li>
          <strong>Local:</strong>
          <% if parada.local.blank? %>
            Local indisponível
          <% else %>
            <%= parada.local %>
          <% end %>
          - <strong>Data/Hora:</strong>
          <% if parada.data_hora.present? %>
            <%= parada.data_hora.strftime('%d/%m/%Y %H:%M') %>
          <% else %>
            Data/hora indisponível
          <% end %>
        </li>
      <% end %>
    <% end %>
  </ul>

  <div class="text-center mt-3">
    <%= link_to 'Editar', edit_carona_path(@carona), class: 'btn btn-primary' %> |
    <%= link_to 'Excluir', delete_carona_path, method: :delete, data: { confirm: 'Tem certeza?' }, class: 'btn btn-danger' %> |
    <%= link_to 'Voltar para Listagem', caronas_path, class: 'btn btn-success' %>
  </div>
</div>
<%= render "rodape" %>



