<%= stylesheet_link_tag "bootstrap.css" %>
<%= render "cabecalho" %>
<div class="container p-3">
  <h1>Listagem de Caronas</h1>

  <table>
    <thead>
      <tr>
        <th>Nome</th>
        <th>Local de Partida</th>
        <th>Destino</th>
        <th>Dia</th>
        <th>Hora</th>
        <th>Opções</th>
      </tr>
    </thead>
    <tbody>
      <% @caronas.each do |carona| %>
        <tr>
          <td><%= carona.nome.blank? ? 'Sem nome' : carona.nome %></td>
          <td><%= carona.local_partida.blank? ? 'Sem partida' : carona.local_partida %></td>
          <td><%= carona.destino.blank? ? 'Sem destino' : carona.destino %></td>
          <td><%= carona.dia.present? ? carona.dia.strftime('%d/%m/%Y') : 'Sem dia' %></td>
          <td><%= carona.hora.present? ? carona.hora.strftime('%H:%M') : 'Sem hora' %></td>
          <td>
            <%= link_to 'Ver Detalhes', carona, class: 'btn btn-link' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="text-center mt-3">
    <%= link_to 'Nova Carona', new_carona_path, class: 'btn btn-primary' %>
    <%= link_to "Voltar para Campus", campus_path, class: 'btn btn-success' %>
  </div>
</div>
<%= render "rodape" %>



