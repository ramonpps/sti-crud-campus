<h1>Listagem de Caronas</h1>

<table>
  <thead>
    <tr>
      <th>Nome</th>
      <th>Local de Partida</th>
      <th>Destino</th>
      <th>Dia</th>
      <th>Hora</th>
      <th>Opções</th>
    </tr>
  </thead>
  <tbody>
    <% @caronas.each do |carona| %>
      <tr>
        <td><%= carona.nome %></td>
        <td><%= carona.local_partida %></td>
        <td><%= carona.destino %></td>
        <td><%= carona.dia.strftime('%d/%m/%Y') %></td>
        <td><%= carona.hora.strftime('%H:%M') %></td>
        <td>
          <%= link_to 'Ver Detalhes', carona %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= link_to 'Nova Carona', new_carona_path %>