<div id="<%= dom_id(campu) %>">
  <p>
    <strong>Nome:</strong>
    <% if campu.Descrição.blank? %>
      Nome indisponível
    <% else %>
      <%= campu.Descrição %>
    <% end %>
  </p>

  <p>
    <strong>Endereço:</strong>
    <% if campu.Endereço.blank? %>
      Endereço indisponível
    <% else %>
      <%= campu.Endereço %>
    <% end %>
  </p>

  <p>
    <strong>Número:</strong>
    <% if campu.Número.blank? %>
      Número indisponível
    <% else %>
      <%= campu.Número %>
    <% end %>
  </p>

  <p>
    <strong>Bairro:</strong>
    <% if campu.Bairro.blank? %>
      Bairro indisponível
    <% else %>
      <%= campu.Bairro %>
    <% end %>
  </p>

  <p>
    <strong>Cidade:</strong>
    <% if campu.Cidade.blank? %>
      Cidade indisponível
    <% else %>
      <%= campu.Cidade %>
    <% end %>
  </p>

  <p>
    <strong>Cep:</strong>
    <% if campu.CEP.nil? %>
      CEP indisponível
    <% else %>
      <%= campu.CEP %>
    <% end %>
  </p>

  <p>
    <strong>Desativação:</strong>
    <% if campu.Desativação.nil? %>
      Ativo
    <% else %>
      <%= campu.Desativação %>
    <% end %>
  </p>
</div>

