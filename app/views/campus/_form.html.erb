<%= form_with(model: campu) do |form| %>
  <% if campu.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(campu.errors.count, "error") %> prohibited this campu from being saved:</h2>

      <ul>
        <% campu.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :Descrição, style: "display: block" %>
    <%= form.text_field :Descrição %>
  </div>

  <div>
    <%= form.label :Endereço, style: "display: block" %>
    <%= form.text_field :Endereço %>
  </div>

  <div>
    <%= form.label :Número, style: "display: block" %>
    <%= form.number_field :Número %>
  </div>

  <div>
    <%= form.label :Bairro, style: "display: block" %>
    <%= form.text_field :Bairro %>
  </div>

  <div>
    <%= form.label :Cidade, style: "display: block" %>
    <%= form.text_field :Cidade %>
  </div>

  <div>
    <%= form.label :CEP, style: "display: block" %>
    <%= form.text_field :CEP %>
  </div>

  <div>
    <%= form.label :Desativação, style: "display: block" %>
    <%= form.date_field :Desativação %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
