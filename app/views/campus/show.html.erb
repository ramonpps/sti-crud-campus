<%= stylesheet_link_tag "bootstrap.css" %>
<%=render "cabecalho" %>
<div class="container">
  <p style="color: green"><%= notice %></p>

  <%= render @campu %>

  <div class="text-center mt-3">
    <%= link_to "Edit this campu", edit_campu_path(@campu), class: 'btn btn-primary' %> |
    <%= link_to "Back to campus", campus_path, class: 'btn btn-link' %>

    <%= button_to "Destroy this campu", @campu, method: :delete, class: 'btn btn-danger', data: { confirm: 'Are you sure?' } %>
  </div>
</div>
<%=render "rodape" %>