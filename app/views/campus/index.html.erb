<%= stylesheet_link_tag "bootstrap.css" %>
<%=render "cabecalho" %>
<div class="container">
  <p style="color: green"><%= notice %></p>

  <h1>Campus</h1>

  <div id="campus">
    <% @campus.each do |campu| %>
      <%= render campu %>
      <p>
        <%= link_to "Show this campu", campu, class: 'btn btn-link' %>
      </p>
    <% end %>
  </div>

  <div class="text-center mt-3">
    <%= link_to "New campu", new_campu_path, class: 'btn btn-primary' %>
    <%= link_to "Ir para Caronas", caronas_path, class: 'btn btn-link' %>
  </div>
</div>
<%=render "rodape" %>
